# Скопируйте в .env (локально) или впишите в настройки хостинга.

# Ключ Claude API: https://console.anthropic.com -> API Keys (обязательно)
ANTHROPIC_API_KEY=

# Модель и «глубина размышлений». По умолчанию claude-opus-5-5 с effort=low.
# Дешевле в разы: MODEL=claude-haiku-5-5
MODEL=claude-opus-5-5
EFFORT=low

# Заявки в Telegram: токен бота от @BotFather и ваш chat id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# С каких сайтов разрешено подключать виджет (через запятую). * = с любых.
# Для клиента лучше указать его домен: https://cafe-beispiel.de,https://www.cafe-beispiel.de
ALLOWED_ORIGINS=*

# Защита от спама и перерасхода
RATE_LIMIT_PER_5MIN=20
DAILY_MESSAGE_LIMIT=500
