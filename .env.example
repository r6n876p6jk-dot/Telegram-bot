# Скопируйте этот файл в .env и заполните. Файл .env не загружается в GitHub.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Токен платёжного провайдера для оплаты картой (@BotFather -> бот -> Payments).
# Оставьте пустым, если продаёте только за Telegram Stars.
PROVIDER_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot) — для уведомлений о продажах и админ-команд
ADMIN_ID=

# Валюта для оплаты картой
CARD_CURRENCY=RUB
